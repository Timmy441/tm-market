# Copy to .env (never commit .env). On Fly use: fly secrets set NAME=value
JWT_SECRET=
DATABASE_URL=            # Neon connection string (postgres://...?sslmode=require)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEW_LISTING_STATUS=active   # set to "pending" later to require admin approval
ALLOWED_ORIGINS=            # extra comma-separated origins, e.g. https://your-admin.vercel.app (no trailing slash)

# Password reset emails (Brevo). Set as Fly secrets.
BREVO_API_KEY=
MAIL_FROM_EMAIL=         # a sender address verified in Brevo
MAIL_FROM_NAME=TM Market
SITE_URL=https://tm-market-pi.vercel.app   # public site, used in the reset link (no trailing slash)
# Payments (test keys only until you are ready to go live)
PAYSTACK_SECRET_KEY=
ALLOW_LIVE_PAYMENTS=false
